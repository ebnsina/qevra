# Database (Neon)
# DATABASE_URL is the owner role, as `neon env pull` writes it. Only migrations and the seed use it.
# DATABASE_APP_URL is what the app runs as: the same address with the user `qevra_app` and a
# password you choose. `pnpm db:migrate` creates that role. Row-level security applies to it.
DATABASE_URL=postgres://qevra_owner:owner@localhost:54329/qevra
DATABASE_APP_URL=postgres://qevra_app:app@localhost:54329/qevra

# Object storage (Neon Object Storage; `neon env pull` writes these four)
AWS_ENDPOINT_URL_S3=http://localhost:9010
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Mail (password reset links)
MAIL_SMTP_URL=smtp://localhost:1026
MAIL_FROM=Academy <no-reply@example.com>
